NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173


# Database (MongoDB connection string)

# Local MongoDB or MongoDB Atlas Replica Set URI
MONGO_URI=mongodb://127.0.0.1:27017/email_otp_auth

# Security & Cryptographic Secrets (Must be at least 32 characters)
SESSION_SECRET=your_new_session_secret
OTP_HMAC_SECRET=your_new_otp_hmac_secret
IDEMPOTENCY_HMAC_SECRET=your_new_idempotency_hmac_secret

# 32-byte key (either 32 ascii characters or 64 hex characters) for AES-256-GCM payload encryption
EMAIL_ENCRYPTION_KEY=replace_with_a_64_character_hex_key

# Real Email Delivery Configuration (Resend API)
EMAIL_PROVIDER=resend
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=AI Playground Auth <onboarding@resend.dev>

# Session & Authentication Policies
SESSION_MAX_AGE_MINUTES=60
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
IDEMPOTENCY_RETENTION_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=30

# Frontend Environment Variables
VITE_BACKEND_API_URL=http://localhost:3000
