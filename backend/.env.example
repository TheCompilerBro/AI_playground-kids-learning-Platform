# ==============================================================================
# Server & Environment
# ==============================================================================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# Database (MongoDB connection string)
# ==============================================================================
# Local MongoDB or MongoDB Atlas Replica Set URI
MONGO_URI=mongodb://127.0.0.1:27017/email_otp_auth

# ==============================================================================
# Security & Cryptographic Secrets (Must be at least 32 characters)
# ==============================================================================
SESSION_SECRET=replace_with_a_long_random_session_secret_at_least_32_chars!
OTP_HMAC_SECRET=replace_with_a_separate_random_otp_secret_at_least_32_chars!
IDEMPOTENCY_HMAC_SECRET=replace_with_a_separate_random_idempotency_secret_32_chars!

# 32-byte key (either 32 ascii characters or 64 hex characters) for AES-256-GCM payload encryption
EMAIL_ENCRYPTION_KEY=01234567890123456789012345678901

# ==============================================================================
# Real Email Delivery Configuration
# ==============================================================================
# Provider selection: 'resend', 'smtp', or 'test'
EMAIL_PROVIDER=resend
EMAIL_FROM=AI Playground Auth <auth@example.com>

# Option A: Resend API Configuration
RESEND_API_KEY=re_placeholder_api_key

# Option B: Nodemailer SMTP Configuration (Used when EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@yourdomain.com
SMTP_PASS=smtp_password_here

# ==============================================================================
# Session & Authentication Policies
# ==============================================================================
SESSION_MAX_AGE_MINUTES=60
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
IDEMPOTENCY_RETENTION_HOURS=24
IDEMPOTENCY_LEASE_SECONDS=30

# ==============================================================================
# Frontend Environment Variables
# ==============================================================================
VITE_BACKEND_API_URL=http://localhost:3000
