{
  "openapi": "3.0.3",
  "info": {
    "title": "Email OTP Authentication System with Idempotency Keys",
    "version": "1.0.0",
    "description": "Production-ready, cryptographically secure email OTP authentication system featuring transactional outbox email delivery, HMAC OTP verification, and strict end-to-end request idempotency guarantees."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server"
    }
  ],
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "connect.sid",
        "description": "HttpOnly session cookie"
      }
    },
    "parameters": {
      "IdempotencyKeyHeader": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "UUID v4 idempotency key generated by client. Guarantees that duplicate requests do not cause duplicate side effects.",
        "schema": {
          "type": "string",
          "format": "uuid",
          "example": "9b1deb4d-3b7d-4bad-9bdd-2b0d7b3dcb6d"
        }
      },
      "ClientFlowIdHeader": {
        "name": "X-Client-Flow-Id",
        "in": "header",
        "required": false,
        "description": "Optional anonymous client flow token to scope idempotency records.",
        "schema": {
          "type": "string",
          "example": "flow_839f201ab4"
        }
      }
    },
    "schemas": {
      "ApiResponse": {
        "type": "object",
        "required": ["success", "message", "data", "error"],
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" },
          "data": { "type": "object", "nullable": true },
          "error": {
            "type": "object",
            "nullable": true,
            "properties": {
              "code": { "type": "string" },
              "message": { "type": "string" },
              "details": { "type": "object", "nullable": true }
            }
          }
        }
      },
      "SendOtpRequest": {
        "type": "object",
        "required": ["email"],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "user@example.com"
          }
        }
      },
      "VerifyOtpRequest": {
        "type": "object",
        "required": ["challengeId", "otp"],
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "example": "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
          },
          "otp": {
            "type": "string",
            "pattern": "^[0-9]{6}$",
            "example": "482910"
          }
        }
      },
      "ResendOtpRequest": {
        "type": "object",
        "required": ["challengeId"],
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid",
            "example": "6ba7b810-9dad-11d1-80b4-00c04fd430c8"
          }
        }
      },
      "UserProfile": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "email": { "type": "string" },
          "emailNormalized": { "type": "string" },
          "emailVerified": { "type": "boolean" }
        }
      }
    }
  },
  "paths": {
    "/api/auth/send-otp": {
      "post": {
        "summary": "Request an OTP verification code",
        "description": "Generates a 6-digit OTP code, stores it as an HMAC-SHA256 challenge in MongoDB, and queues delivery via transactional outbox. Replaying with the same Idempotency-Key returns the cached response without sending extra emails.",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKeyHeader" },
          { "$ref": "#/components/parameters/ClientFlowIdHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SendOtpRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OTP challenge accepted and dispatched",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          },
          "400": { "description": "Validation or bad request error" },
          "409": { "description": "Conflict: Operation with this idempotency key is currently processing" },
          "422": { "description": "Unprocessable: Idempotency key reused with different request payload" },
          "429": { "description": "Rate limit exceeded or cooldown active" }
        }
      }
    },
    "/api/auth/verify-otp": {
      "post": {
        "summary": "Verify 6-digit OTP and establish session",
        "description": "Verifies the constant-time HMAC hash of the submitted OTP code. Consumes the challenge atomically and creates an authenticated HTTP-only session cookie.",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKeyHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VerifyOtpRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Verification successful and session established",
            "headers": {
              "Set-Cookie": {
                "description": "HttpOnly, Secure, SameSite connect.sid session cookie",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          },
          "400": { "description": "Invalid, expired, or already used OTP code" },
          "409": { "description": "Operation in progress" },
          "422": { "description": "Idempotency key payload mismatch" },
          "429": { "description": "Verification rate limit exceeded" }
        }
      }
    },
    "/api/auth/resend-otp": {
      "post": {
        "summary": "Resend OTP code after 60-second cooldown",
        "description": "Invalidates previous OTP challenge and issues a fresh one if 60 seconds have elapsed.",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKeyHeader" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ResendOtpRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "New OTP challenge dispatched" },
          "429": { "description": "Cooldown active or resend rate limit exceeded" }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "Get authenticated user profile",
        "description": "Returns current logged in user details based on active session.",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Current user profile",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ApiResponse" }
              }
            }
          },
          "401": { "description": "Unauthorized: No active session" }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "summary": "Sign out and destroy session",
        "description": "Destroys server-side session in MongoDB and clears session cookie.",
        "parameters": [
          { "$ref": "#/components/parameters/IdempotencyKeyHeader" }
        ],
        "responses": {
          "200": { "description": "Successfully signed out" }
        }
      }
    }
  }
}

